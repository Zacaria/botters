{
  "name": "botters",
  "version": "0.1.0",
  "description": "Real-time space strategy you play with your AI agent, over MCP",
  "files": [
    "client.js",
    "install.js",
    "server.js",
    "public-media.js",
    "media/",
    "sim.js",
    "index.html",
    "guide.html",
    "privacy.html",
    "terms.html",
    "DOCTRINE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "bin": {
    "botters": "client.js"
  },
  "scripts": {
    "server": "node server.js",
    "server:online:dev": "node scripts/online-dev.js",
    "build": "node scripts/build.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "test:auth:browser": "playwright test --config=playwright.auth.config.js",
    "test:auth:convex": "vitest run --config vitest.config.js",
    "test:online": "node scripts/verify-online.js"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.52",
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/ws-transport": "^0.17.13",
    "@convex-dev/better-auth": "^0.12.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "^1.6.33",
    "convex": "^1.46.0",
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "convex-test": "^0.0.62",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.12"
  }
}
