{
  "name": "botters",
  "version": "0.1.0",
  "description": "Real-time space strategy you play with your AI agent, over MCP",
  "files": [
    "client.js",
    "server.js",
    "sim.js",
    "index.html",
    "guide.html",
    "privacy.html",
    "terms.html",
    "DOCTRINE.md"
  ],
  "engines": {
    "node": ">=22"
  },
