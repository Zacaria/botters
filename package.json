    "test:browser": "playwright test",
    "test:online": "node scripts/verify-online.js"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "convex": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.28.2"
  }
}
