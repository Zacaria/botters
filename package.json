{
  "name": "botters",
  "version": "0.1.0",
  "description": "Real-time space strategy you play with your AI agent, over MCP",
  "files": [
    "client.js",
    "tools.js",
    "install.js",
    "server.js",
    "public-media.js",
    "media/",
    "sim.js",
    "sim/runtime.js",
    "sim/pkg/",
    "index.html",
    "guide.html",
    "privacy.html",
    "terms.html",
    "DOCTRINE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "bin": {
    "botters": "client.js"
  },
  "scripts": {
    "server": "node server.js",
    "dev": "wrangler dev",
    "build": "node scripts/build.js",
    "build:sim": "node scripts/build-sim.js",
    "check": "node scripts/check.js",
    "build:worker": "npm run build && node scripts/build-cloudflare.js",
    "test": "node scripts/build-cloudflare.js && node --test --test-concurrency=1 test/*.test.js",
    "test:browser": "playwright test",
    "test:cloudflare": "node scripts/build-cloudflare.js && node --test --test-concurrency=1 test/cloudflare-*.test.js"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "1.7.18",

    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",

    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",

    "esbuild": "^0.28.2",
    "miniflare": "^5.20261104.0-beta",

    "wrangler": "^4.158.0"
  }
}
